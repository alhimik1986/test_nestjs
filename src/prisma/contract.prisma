// use prisma-8
model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  url   String?
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    Date
  endDate      Date?
  achievements String
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id            Int     @id @default(autoincrement())
  name          String
  url           String?
  profileId     Int
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
